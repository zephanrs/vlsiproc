#!/usr/bin/env python3
"""
schematic2verilog -- export Cadence schematic cells to project-style Verilog.

Reads a manifest mapping cadence_cell -> verilog_module and emits one .v per
cell. With no -cell argument, processes the whole manifest, skipping cells
whose .v is newer than the schematic. All path defaults resolve from the
git checkout root, so the script can run from anywhere in the tree.

SKILL extracts raw netlist data; Python generates the Verilog.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile

# -----------------------------------------------------------------------
# SKILL: extract netlist to a tab-separated file.
# No string manipulation, regex, or formatting -- just data extraction.
# -----------------------------------------------------------------------
SKILL_EXTRACT = r"""
s2v_prims = '("nmos4" "pmos4" "nmos" "pmos" "nmos1v" "pmos1v" "ipin" "opin" "iopin" "vdd!" "gnd!" "vdd" "gnd" "noConn")

; Emit one cell's netlist to fp.
procedure( s2v_emit( cv fp cellName )
  let( (bits)
    fprintf( fp "cell\t%s\n" cellName )
    foreach( term cv~>terminals
      bits = if( term~>termType == "singleBit" then 1 else length( term~>nets ) )
      fprintf( fp "port\t%s\t%s\t%d\n" term~>name term~>direction bits )
    )
    foreach( net cv~>nets
      fprintf( fp "net\t%s\n" net~>name )
    )
    foreach( inst cv~>instances
      when( inst~>cellName == "noConn"
        foreach( it inst~>instTerms
          when( it~>net
            fprintf( fp "noconn\t%s\n" it~>net~>name )
          )
        )
      )
      unless( inst~>cellName == "noConn"
        fprintf( fp "inst\t%s\t%s" inst~>name inst~>cellName )
        foreach( it inst~>instTerms
          fprintf( fp "\t%s\t%s" it~>name
            if( it~>net then it~>net~>name else "" ) )
        )
        fprintf( fp "\n" )
      )
    )
  )
)

; Recursively walk a schematic, extracting it and any sub-cells that aren't
; in skipList (cells with a hand-written ref Verilog) or in done (already
; extracted this run). Returns the updated done list.
procedure( s2v_walk( libName cellName outDir skipList done )
  prog( (cv fp outFile subCell)
    when( member( cellName done ) return( done ) )
    cv = dbOpenCellViewByType( libName cellName "schematic" "" "r" )
    unless( cv
      fprintf( errport "s2v: WARNING cannot open %s/%s schematic\n" libName cellName )
      return( done )
    )
    outFile = strcat( outDir "/" cellName ".netlist" )
    fp = outfile( outFile "w" )
    unless( fp
      fprintf( errport "s2v: ERROR cannot write %s\n" outFile )
      dbClose( cv )
      return( done )
    )
    s2v_emit( cv fp cellName )
    close( fp )
    printf( "s2v: extracted %s/%s -> %s\n" libName cellName outFile )
    done = cons( cellName done )
    foreach( inst cv~>instances
      subCell = inst~>cellName
      when( and( subCell
                 inst~>master
                 null( member( subCell s2v_prims ) )
                 null( member( subCell skipList ) ) )
        done = s2v_walk( inst~>master~>libName subCell outDir skipList done )
      )
    )
    dbClose( cv )
    return( done )
  )
)
"""

# -----------------------------------------------------------------------
# Primitives that are not rendered as module instances
# -----------------------------------------------------------------------
PRIMITIVES = {
    "nmos4", "pmos4", "nmos", "pmos",
    "nmos1v", "pmos1v",
    "ipin", "opin", "iopin",
    "vdd!", "gnd!", "vdd", "gnd",
    "noConn",
}

MOS_CELLS = {"nmos4", "pmos4", "nmos1v", "pmos1v", "nmos", "pmos"}

SUPPLY_NETS = {"vdd!", "gnd!", "vdd", "gnd"}

def supply_name(n):
    if n == "vdd!": return "vdd"
    if n == "gnd!": return "gnd"
    return n

_RANGE_RE = re.compile(r'<(\d+):(\d+)>')

def vlog_name(n):
    """Convert Cadence <> bus notation to Verilog [], normalizing ascending
    ranges (<lo:hi>) to descending ([hi:lo]) so slices match [N:0] declarations."""
    def fix(m):
        a, b = int(m.group(1)), int(m.group(2))
        return f"[{max(a, b)}:{min(a, b)}]"
    n = _RANGE_RE.sub(fix, n)
    return n.replace("<", "[").replace(">", "]")

def strip_pin_range(pin):
    """`.sel<1:0>` -> `sel`, `.out<7>` -> `out`, `clk` -> `clk`."""
    return re.sub(r'<\d+(?::\d+)?>$', '', pin)

# Cadence broadcast/replication: '<*N>x' (Virtuoso's iteration notation) or
# the rarer '[*N]x' / '*N x' forms. Group 1/2/3 holds N; the last group is the inner.
_BCAST_RE = re.compile(r'^(?:<\*(\d+)>|\[\*(\d+)\]|\*(\d+)\s+)\s*(.+)$')

def _convert_one(part):
    """Convert one Cadence net atom: '<*N>x' / '[*N]x' / '*N x' -> '{N{x}}', '<>' -> '[]'.
    Normalizes Cadence supply suffixes inside the inner expression so
    '<*4>gnd!' becomes '{4{gnd}}' (not '{4{gnd!}}', which is invalid Verilog)."""
    part = part.strip()
    m = _BCAST_RE.match(part)
    if m:
        n = m.group(1) or m.group(2) or m.group(3)
        return "{" + n + "{" + supply_name(vlog_name(m.group(4))) + "}}"
    return supply_name(vlog_name(part))

def cad_net_to_verilog(net):
    """Full Cadence net expression -> Verilog. Handles concat, replication, <>."""
    if not net:
        return ""
    parts = [p.strip() for p in net.split(',')]
    converted = [_convert_one(p) for p in parts]
    return "{" + ", ".join(converted) + "}" if len(converted) > 1 else converted[0]

def extract_signals(net):
    """Underlying signal names referenced by a Cadence net expression
    (for internal-net declaration tracking). Strips '[*N]' or '*N '
    broadcast prefixes and splits comma-separated concat parts."""
    if not net:
        return []
    result = []
    for part in net.split(','):
        part = part.strip()
        m = _BCAST_RE.match(part)
        if m:
            part = m.group(4)
        result.append(part)
    return result

def guard_name(cell):
    """MyCell_8b -> MY_CELL_8B_V"""
    s = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", cell)
    s = re.sub(r"[^A-Za-z0-9]+", "_", s)
    s = s.strip("_").upper()
    return s + "_V"

def pad(s, width):
    return s.ljust(width)

# -----------------------------------------------------------------------
# Git root + manifest helpers
# -----------------------------------------------------------------------
def find_git_root():
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None

def load_manifest(path):
    """Parse manifest with optional [library] section headers.
    Returns list of (library, cadence_cell, verilog_module) tuples.
    Default library is 'processor' if no header appears before the first entry."""
    if not os.path.isfile(path):
        sys.exit(f"error: manifest not found: {path}")
    entries     = []
    current_lib = "processor"
    with open(path) as f:
        for lineno, line in enumerate(f, 1):
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith("[") and line.endswith("]"):
                current_lib = line[1:-1].strip()
                if not current_lib:
                    sys.exit(f"error: {path}:{lineno}: empty library name in section header")
                continue
            parts = line.split()
            if len(parts) != 2:
                sys.exit(f"error: {path}:{lineno}: expected 2 tokens, got: {line}")
            entries.append((current_lib, parts[0], parts[1]))
    return entries

def manifest_dict(entries):
    """cadence_cell -> verilog_module, used for sub-cell name resolution."""
    return {cad: vname for _, cad, vname in entries}

def is_stale(lib, cad_cell, vname, cds_dir, out_dir):
    """True if the cadence schematic is newer than the generated .v (or .v missing)."""
    vlg = os.path.join(out_dir, vname + ".v")
    if not os.path.isfile(vlg):
        return True
    sch = os.path.join(cds_dir, lib, cad_cell, "schematic", "sch.oa")
    if not os.path.isfile(sch):
        return True   # let virtuoso surface the real error
    return os.path.getmtime(sch) > os.path.getmtime(vlg)

# -----------------------------------------------------------------------
# Parse the tab-separated netlist file written by SKILL
# -----------------------------------------------------------------------
def parse_netlist(path):
    cell_name   = None
    raw_ports   = []        # list of (base, direction, max_bit)
    nets        = []        # list of raw net names
    insts       = []        # list of (instName, cellName, [(pin, net), ...])
    noconn_nets = set()     # raw net names that terminate at a noConn marker

    with open(path) as f:
        for line in f:
            line = line.rstrip("\n")
            if not line:
                continue
            parts = line.split("\t")
            tag = parts[0]
            if tag == "cell":
                cell_name = parts[1]
            elif tag == "port":
                _, name, direction, bits = parts
                # Pull a baked-in <hi:lo> or <N> out of the name. Multiple
                # bit-selected port labels for the same base get coalesced
                # after the loop, preserving the actual [hi:lo] range.
                base, hi, lo = _parse_cadence_range(name)
                if hi is not None:
                    raw_ports.append((base, direction, max(hi, lo), min(hi, lo)))
                else:
                    # SKILL sometimes reports bits=0 for scalar terminals it
                    # can't classify -- treat <=1 as scalar to avoid '[-1:0]'.
                    bits = int(bits)
                    if bits <= 1:
                        raw_ports.append((name, direction, 0, 0))
                    else:
                        raw_ports.append((name, direction, bits - 1, 0))
            elif tag == "net":
                nets.append(parts[1])
            elif tag == "noconn":
                noconn_nets.add(parts[1])
            elif tag == "inst":
                inst_name = parts[1]
                cell      = parts[2]
                conns = []
                for i in range(3, len(parts) - 1, 2):
                    conns.append((parts[i], parts[i+1]))
                insts.append((inst_name, cell, conns))

    ports = _coalesce_ports(raw_ports)
    return cell_name, ports, nets, insts, noconn_nets

# -----------------------------------------------------------------------
# Array-instance unrolling
# -----------------------------------------------------------------------
def _parse_cadence_range(name):
    """'foo<6:1>' -> ('foo', 6, 1).  'foo<3>' -> ('foo', 3, 3).  Else ('foo', None, None)."""
    m = re.match(r'^(.+)<(\d+):(\d+)>$', name)
    if m:
        return m.group(1), int(m.group(2)), int(m.group(3))
    m = re.match(r'^(.+)<(\d+)>$', name)
    if m:
        b = int(m.group(2))
        return m.group(1), b, b
    return name, None, None

_NMOS_PRIMS = {"nmos4", "nmos1v", "nmos"}
_PMOS_PRIMS = {"pmos4", "pmos1v", "pmos"}

def _reorient_mos(insts, input_port_bases):
    """Only re-orient transmission-gate pairs (one nmos + one pmos sharing the
    same two endpoints). For each TG, source should be the 'strong' endpoint:
    a rail (vdd/gnd), an input port, or a CMOS-driven net (one that has both
    an nmos-to-gnd pull and a pmos-to-vdd pull elsewhere). All other
    transistors -- inverters, NAND/NOR pull-up/pull-down stacks, series
    chains -- get left alone since their D/S labeling is already meaningful."""
    rails = {"vdd", "gnd", "vdd!", "gnd!"}

    def base(n):
        b, _, _ = _parse_cadence_range(n) if n else (n, None, None)
        return b

    nmos_pulls = set()   # net is the drain of an nmos whose source is gnd
    pmos_pulls = set()   # net is the drain of a pmos whose source is vdd
    for _, cell, conns in insts:
        if cell not in MOS_CELLS:
            continue
        cd = dict(conns)
        d, s = base(cd.get("D", "")), base(cd.get("S", ""))
        if cell in _NMOS_PRIMS:
            if s in {"gnd", "gnd!"}: nmos_pulls.add(d)
            if d in {"gnd", "gnd!"}: nmos_pulls.add(s)
        elif cell in _PMOS_PRIMS:
            if s in {"vdd", "vdd!"}: pmos_pulls.add(d)
            if d in {"vdd", "vdd!"}: pmos_pulls.add(s)
    strong = (nmos_pulls & pmos_pulls) | rails | set(input_port_bases)

    # Index transistors by their endpoint set so we can find TG complements.
    by_ends = {}        # frozenset({d, s}) -> list of (idx, cell)
    for i, (_, cell, conns) in enumerate(insts):
        if cell not in MOS_CELLS:
            continue
        cd = dict(conns)
        d, s = base(cd.get("D", "")), base(cd.get("S", ""))
        if d and s:
            by_ends.setdefault(frozenset([d, s]), []).append((i, cell))

    result = []
    for i, (inst_name, cell, conns) in enumerate(insts):
        if cell not in MOS_CELLS:
            result.append((inst_name, cell, conns))
            continue
        cd = dict(conns)
        d, s = base(cd.get("D", "")), base(cd.get("S", ""))
        peers = by_ends.get(frozenset([d, s]), [])
        is_tg = any(
            j != i and (
                (cell in _NMOS_PRIMS and pcell in _PMOS_PRIMS) or
                (cell in _PMOS_PRIMS and pcell in _NMOS_PRIMS)
            )
            for j, pcell in peers
        )
        if not is_tg:
            result.append((inst_name, cell, conns))
            continue
        # TG pair. If drain is strong and source isn't, swap so source = strong.
        if d in strong and s not in strong:
            swap = {"D": "S", "S": "D"}
            new_conns = [(swap.get(p, p), n) for p, n in conns]
            result.append((inst_name, cell, new_conns))
        else:
            result.append((inst_name, cell, conns))
    return result


def _expand_concat_bits(net):
    """Flatten a Cadence concat / replication net expression into a flat list
    of single-bit references in MSB-first (left-to-right) order. Buses expand
    high-to-low; '<*N>' replicates N times. Used to distribute one bit per
    array instance when the comma-element count doesn't match (e.g.
    `<*4>x,<*4>y` for an 8-instance array)."""
    bits = []
    for part in net.split(','):
        part = part.strip()
        m = _BCAST_RE.match(part)
        if m:
            count = int(m.group(1) or m.group(2) or m.group(3))
            inner = m.group(4)
        else:
            count = 1
            inner = part
        base, hi, lo = _parse_cadence_range(inner)
        if hi is None or hi == lo:
            inner_bits = [inner]
        else:
            if hi >= lo:
                bit_idxs = list(range(hi, lo - 1, -1))
            else:
                bit_idxs = list(range(hi, lo + 1))
            inner_bits = [f"{base}<{b}>" for b in bit_idxs]
        bits.extend(inner_bits * count)
    return bits

def _coalesce_ports(raw_ports):
    """Merge multiple bit-selected port labels (`inst<13>`, `inst<11:9>`, ...)
    into one bus port spanning [max_hi:min_lo]. Preserves non-zero LSB so a
    schematic-declared `wen<7:1>` stays 7-bit, not silently widened to 8."""
    grouped = {}    # base -> [direction, max_hi, min_lo]
    order   = []
    for base, direction, hi, lo in raw_ports:
        if base in grouped:
            grouped[base][1] = max(grouped[base][1], hi)
            grouped[base][2] = min(grouped[base][2], lo)
        else:
            grouped[base] = [direction, hi, lo]
            order.append(base)
    return [(base, grouped[base][0], grouped[base][1], grouped[base][2]) for base in order]

def _expand_insts(insts):
    """
    Unroll array instances.  'I1<6:1>' expands to I1_6, I1_5, ..., I1_1.
    Bus connections are sliced per element; scalar connections are shared.
    """
    result = []
    for inst_name, cell, conns in insts:
        base, hi, lo = _parse_cadence_range(inst_name)
        if hi is None:
            result.append((inst_name, cell, conns))
            continue

        if hi >= lo:
            indices = list(range(hi, lo - 1, -1))
        else:
            indices = list(range(hi, lo + 1))

        for offset, idx in enumerate(indices):
            new_conns = []
            for pin, net in conns:
                # Flatten concats and replications to bits and distribute one
                # per instance whenever the bit count matches the array size.
                if ',' in net or _BCAST_RE.match(net):
                    expanded = _expand_concat_bits(net)
                    if expanded and len(expanded) == len(indices):
                        new_conns.append((pin, expanded[offset]))
                        continue
                    # Single broadcast '<*N>x' (no commas): each instance gets
                    # the bare inner expression -- this is the right thing
                    # whether x is a scalar or a multi-bit bus going to a
                    # multi-bit pin per instance.
                    if ',' not in net:
                        m = _BCAST_RE.match(net)
                        if m:
                            new_conns.append((pin, m.group(4)))
                            continue
                    # Concat with mismatched bit count -- pass whole expr.
                    new_conns.append((pin, net))
                    continue
                net_base, net_hi, net_lo = _parse_cadence_range(net)
                if net_hi is not None:
                    if net_hi >= net_lo:
                        net_bits = list(range(net_hi, net_lo - 1, -1))
                    else:
                        net_bits = list(range(net_hi, net_lo + 1))
                    # Per-bit slice when net width matches array length;
                    # otherwise broadcast (e.g. a 2-bit sel shared across 8 instances).
                    if len(net_bits) == len(indices):
                        new_conns.append((pin, f"{net_base}<{net_bits[offset]}>"))
                    else:
                        new_conns.append((pin, net))
                else:
                    new_conns.append((pin, net))
            result.append((f"{base}_{idx}", cell, new_conns))

    return result

# -----------------------------------------------------------------------
# Ref-module port parser: lets us prune schematic-only "scoping" pins
# from a generated module so the boundary matches the ref interface.
# -----------------------------------------------------------------------
_REF_PORT_RE = re.compile(
    r'\b(input|output|inout)\s+(?:logic|wire|reg)?\s*'
    r'(?:\[\s*(\d+)\s*:\s*(\d+)\s*\])?\s*(\w+)'
)

def parse_ref_ports(ref_dir, vname):
    """Return {portname: (direction, hi, lo)} from ref/<vname>.v, or None.
    Best-effort: only used to identify which schematic ports are extras."""
    path = os.path.join(ref_dir, vname + ".v")
    if not os.path.isfile(path):
        return None
    with open(path) as f:
        text = f.read()
    text = re.sub(r'//[^\n]*', '', text)
    text = re.sub(r'/\*.*?\*/', '', text, flags=re.DOTALL)
    m = re.search(r'\bmodule\s+\w+\s*\((.*?)\)\s*;', text, re.DOTALL)
    if not m:
        return None
    portlist = m.group(1)
    out = {}
    for raw in portlist.split(','):
        m2 = _REF_PORT_RE.search(raw)
        if not m2:
            continue
        d, hi, lo, name = m2.group(1), m2.group(2), m2.group(3), m2.group(4)
        hi = int(hi) if hi is not None else 0
        lo = int(lo) if lo is not None else 0
        out[name] = (d, hi, lo)
    return out

def classify_extra_input(name, ref_ports):
    """Schematic-only input -> matching ref port name (or None)."""
    n = name.lower()
    if "clk" in n and "clk" in ref_ports:
        return "clk"
    if ("rst" in n or "reset" in n) and "rst" in ref_ports:
        return "rst"
    return None

# -----------------------------------------------------------------------
# Generate Verilog from parsed netlist
# -----------------------------------------------------------------------
def generate_verilog(cell_name, ports, nets, insts, noconn_nets, ref_dir, out_dir, manifest):
    guard = guard_name(cell_name)

    noconn_vlog = {cad_net_to_verilog(n) for n in noconn_nets}
    insts = _expand_insts(insts)
    input_port_bases = {name for name, direction, *_ in ports if direction == "input"}
    insts = _reorient_mos(insts, input_port_bases)

    dir_map    = {"input": "input ", "output": "output", "inputOutput": "inout "}

    # --- ref-port filter: schematic ports that aren't in the ref get
    #     demoted (outputs -> internal wires; clk/rst-named inputs ->
    #     remapped to ref's clk/rst). Lets the schematic carry extra
    #     scope-only output pins and a clock-tree of per-register clocks
    #     while still presenting the ref's standard boundary.
    ref_ports = parse_ref_ports(ref_dir, cell_name)
    extra_remap = {}        # schematic port name -> ref port name
    dropped_outputs = set() # schematic output ports demoted to internal wires
    if ref_ports is not None:
        ref_names = set(ref_ports.keys())
        schem_names = {p[0] for p in ports}
        kept_ports = []
        for name, direction, hi, lo in ports:
            if name in ref_names:
                kept_ports.append((name, direction, hi, lo))
                continue
            if direction == "output":
                dropped_outputs.add(name)
                continue
            if direction == "input":
                target = classify_extra_input(name, ref_ports)
                if target is None:
                    sys.exit(
                        f"error: schematic {cell_name!r} has extra input "
                        f"{name!r} with no obvious mapping to a ref port "
                        f"({sorted(ref_names)})"
                    )
                extra_remap[name] = target
                continue
            kept_ports.append((name, direction, hi, lo))
        # Add any ref ports not already present (e.g. ref has 'clk' but
        # the schematic only has per-register clk pins).
        kept_bases = {p[0] for p in kept_ports}
        for rname, (rdir, rhi, rlo) in ref_ports.items():
            if rname in kept_bases:
                continue
            if rname in extra_remap.values():
                kept_ports.append((rname, rdir, rhi, rlo))
        # Preserve ref order on output for readability.
        order = {n: i for i, n in enumerate(ref_ports.keys())}
        kept_ports.sort(key=lambda p: order.get(p[0], 9999))
        ports = kept_ports

    port_bases = {p[0] for p in ports}

    # --- includes: one per unique sub-cell, ref preferred ---
    seen_incs = set()
    includes  = []
    for _, cell, _ in insts:
        if cell in PRIMITIVES:
            continue
        vcell = manifest.get(cell, cell)
        ref_file = os.path.join(ref_dir, vcell + ".v")
        inc = f"ref/{vcell}.v" if os.path.isfile(ref_file) else f"schematic/{vcell}.v"
        if inc not in seen_incs:
            seen_incs.add(inc)
            includes.append(inc)

    # --- port list ---
    def width_str(hi, lo):
        return "" if hi == lo else f"[{hi}:{lo}]"

    def type_str(direction, hi, lo):
        # Use 'wire' (not 'logic') so iverilog allows multiple drivers --
        # transistor-level cells often have pull-up and pull-down networks
        # both driving the same node, and dynamic-logic nets get pre-charged.
        d = dir_map.get(direction, "inout ")
        w = width_str(hi, lo)
        return f"{d} wire {w}" if w else f"{d} wire"

    port_type_strs = [type_str(d, hi, lo) for _, d, hi, lo in ports]
    max_type_len   = max((len(s) for s in port_type_strs), default=0)

    # --- internal nets ---
    def _parse_net_decl(name):
        """Parse arbitrary sub-bus combinations and bits for declarations."""
        m_range = re.match(r'^(.+)<(\d+):(\d+)>$', name)
        if m_range:
            hi = int(m_range.group(2))
            lo = int(m_range.group(3))
            return m_range.group(1), max(hi, lo), min(hi, lo)
        m_bit = re.match(r'^(.+)<(\d+)>$', name)
        if m_bit:
            return m_bit.group(1), int(m_bit.group(2)), int(m_bit.group(2))
        return name, None, None

    all_raw_nets = set()
    for n in nets:
        for sig in extract_signals(n):
            all_raw_nets.add(sig)
    for _, _, conns in insts:
        for _, net in conns:
            for sig in extract_signals(net):
                all_raw_nets.add(sig)

    bus_max = {}
    scalar_nets_set = set()
    has_vdd = False
    has_gnd = False

    for raw in all_raw_nets:
        vn = supply_name(vlog_name(raw))
        if vn == "vdd": has_vdd = True
        if vn == "gnd": has_gnd = True

        base, hi, lo = _parse_net_decl(raw)
        vbase = vlog_name(base)
        vnet  = vlog_name(raw)

        if base in port_bases or vbase in port_bases:
            continue
        if base in SUPPLY_NETS or vbase in SUPPLY_NETS:
            continue
        if vnet in noconn_vlog:
            continue
        # Extra schematic-only inputs (e.g. pc_clk) get rewritten to a real
        # ref port (clk/rst) via remap_drv — don't redeclare them.
        if base in extra_remap or vbase in extra_remap:
            continue

        if hi is not None:
            if vbase in bus_max:
                ph, pl = bus_max[vbase]
                bus_max[vbase] = (max(ph, hi, lo), min(pl, hi, lo))
            else:
                bus_max[vbase] = (max(hi, lo), min(hi, lo))
        else:
            scalar_nets_set.add(vbase)

    scalar_nets = [n for n in scalar_nets_set if n not in bus_max]

    # Single-driver bridging: every output port gets an internal '<name>_drv'
    # wire that absorbs all in-module drivers (transistors / sub-cell outputs);
    # an `assign port = port_drv;` at the end exposes a single driver to the
    # boundary so a `logic out` testbench signal (uwire) doesn't blow up.
    output_port_widths = {name: (hi, lo) for name, direction, hi, lo in ports
                          if direction == "output"}

    def remap_drv(net):
        """Rewrite a net reference for the output:
          1. extra-input pin (e.g. pc_clk) -> mapped ref port (clk)
          2. real output port -> '<name>_drv' single-driver wire
        Slice/concat brackets are preserved."""
        if not net:
            return net
        m = re.match(r'^(\w+)(\[.*\])?$', net)
        if m:
            base = m.group(1)
            tail = m.group(2) or ""
            if base in extra_remap:
                return f"{extra_remap[base]}{tail}"
            if base in output_port_widths:
                return f"{base}_drv{tail}"
        return net

    int_net_decls = [f"wire {n};" for n in sorted(scalar_nets)]
    for base, (hi, lo) in sorted(bus_max.items()):
        # Always emit a range -- some downstream connection used <N> bit-select,
        # so the net must be a vector (even if hi == lo, e.g. just bit 0 used).
        int_net_decls.append(f"wire [{hi}:{lo}] {base};")
    for name, (hi, lo) in sorted(output_port_widths.items()):
        if hi == lo:
            int_net_decls.append(f"wire {name}_drv;")
        else:
            int_net_decls.append(f"wire [{hi}:{lo}] {name}_drv;")

    # --- sub-cell instances ---
    sub_insts = []
    mos_lines = []

    for inst_name, cell, conns in insts:
        if cell in MOS_CELLS:
            pins = {p: supply_name(vlog_name(n)) for p, n in conns}
            d = remap_drv(pins.get("D", ""))
            g = remap_drv(pins.get("G", ""))
            s = remap_drv(pins.get("S", ""))
            prim = "nmos" if cell in {"nmos4", "nmos1v", "nmos"} else "pmos"
            mos_lines.append(f"  {prim} {inst_name:<10} ( {d}, {s}, {g} );")
        elif cell in PRIMITIVES:
            continue
        else:
            vcell = manifest.get(cell, cell)
            vconns = []
            for p, n in conns:
                vp = strip_pin_range(p)
                vn = remap_drv(supply_name(cad_net_to_verilog(n)))
                vconns.append((vp, vn))
            sub_insts.append((vcell, inst_name, vconns))

    # ----------------------------------------------------------------
    # Write the file
    # ----------------------------------------------------------------
    out_path = os.path.join(out_dir, cell_name + ".v")
    lines = []

    def h(s=""):
        lines.append(s)

    h("//" + "=" * 72)
    h(f"// {cell_name} (generated by schematic2verilog)")
    h("//" + "=" * 72)
    h()
    h(f"`ifndef {guard}")
    h(f"`define {guard}")

    if includes:
        h()
        for inc in includes:
            h(f'`include "{inc}"')

    # Schematic-derived structural Verilog routinely has dangling/unused nets
    # and width quirks that are normal for a transistor-level netlist.
    h()
    for w in ("UNUSED", "UNUSEDSIGNAL", "UNDRIVEN",
              "WIDTH", "WIDTHCONCAT", "WIDTHEXPAND", "WIDTHTRUNC"):
        h(f"/* verilator lint_off {w} */")

    h()
    h(f"module {cell_name}")
    h("(")
    for i, ((name, direction, _, _), ts) in enumerate(zip(ports, port_type_strs)):
        comma = "," if i < len(ports) - 1 else ""
        h(f"  {pad(ts, max_type_len)} {vlog_name(name)}{comma}")
    h(");")

    supply_lines = []
    if has_vdd and "vdd" not in port_bases:
        supply_lines.append("  supply1 vdd;")
    if has_gnd and "gnd" not in port_bases:
        supply_lines.append("  supply0 gnd;")

    if supply_lines:
        h()
        for line in supply_lines:
            h(line)

    if int_net_decls:
        h()
        for d in int_net_decls:
            h(f"  {d}")

    for cell, inst_name, vconns in sub_insts:
        max_pin = max((len(p) for p, _ in vconns), default=0)
        h()
        h(f"  {cell} {inst_name}")
        h("  (")
        for j, (pin, net) in enumerate(vconns):
            comma = "," if j < len(vconns) - 1 else ""
            if net in noconn_vlog or net == "":
                h(f"    .{pad(pin, max_pin)} (){comma}")
            else:
                h(f"    .{pad(pin, max_pin)} ({net}){comma}")
        h("  );")

    if mos_lines:
        h()
        for ml in mos_lines:
            h(ml)

    if output_port_widths:
        h()
        for name in sorted(output_port_widths):
            h(f"  assign {name} = {name}_drv;")

    h()
    h("endmodule")

    h()
    for w in ("WIDTHTRUNC", "WIDTHEXPAND", "WIDTHCONCAT", "WIDTH",
              "UNDRIVEN", "UNUSEDSIGNAL", "UNUSED"):
        h(f"/* verilator lint_on {w} */")

    h()
    h(f"`endif /* {guard} */")

    with open(out_path, "w") as f:
        f.write("\n".join(lines) + "\n")

    print(f"s2v: wrote {out_path}")

# -----------------------------------------------------------------------
# Find virtuoso
# -----------------------------------------------------------------------
def find_virtuoso():
    v = shutil.which("virtuoso")
    if v:
        return v
    for p in [
        "/cadence/installs/IC618/bin/virtuoso",
        "/cadence/installs/IC617/bin/virtuoso",
        "/opt/cadence/IC618/bin/virtuoso",
        "/opt/cadence/IC617/bin/virtuoso",
    ]:
        if os.path.isfile(p):
            return p
    return None

# -----------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------
def main():
    root = find_git_root()
    p = argparse.ArgumentParser(
        description="Export Cadence schematic cells to project-style Verilog."
    )
    p.add_argument("-cell",     action="append", dest="cells", metavar="CELL",
                   help="filter to these cells (repeatable, bypasses stale check); "
                        "default: every manifest cell whose schematic is newer than its .v")
    p.add_argument("-manifest", default=root and f"{root}/cadence/cells.txt", metavar="FILE")
    p.add_argument("-out",      default=root and f"{root}/v/schematic",       metavar="DIR")
    p.add_argument("-ref",      default=root and f"{root}/v/ref",             metavar="DIR")
    p.add_argument("-cds",      default=root and f"{root}/cadence",           metavar="DIR")
    args = p.parse_args()

    for k in ("manifest", "out", "ref", "cds"):
        if getattr(args, k) is None:
            sys.exit(f"error: not in a git checkout -- pass -{k} explicitly")

    cds_dir = os.path.realpath(args.cds)
    out_dir = os.path.realpath(args.out)
    ref_dir = os.path.realpath(args.ref)

    if not os.path.isfile(os.path.join(cds_dir, "cds.lib")):
        sys.exit(f"error: no cds.lib in {cds_dir}")

    manifest = load_manifest(args.manifest)
    mdict    = manifest_dict(manifest)

    def _has_ref(vname):
        return os.path.isfile(os.path.join(ref_dir, vname + ".v"))

    if args.cells:
        by_cad = {cad: (lib, vname) for lib, cad, vname in manifest}
        unknown = [c for c in args.cells if c not in by_cad]
        if unknown:
            sys.exit(f"error: not in manifest: {unknown}")
        cells = [(by_cad[c][0], c, by_cad[c][1]) for c in args.cells]
    else:
        # Default mode: skip cells whose vname already has a ref Verilog.
        # Their schematic version (often transistor-level) is non-simulatable
        # for iverilog; consumers `\include "ref/<vname>.v"` instead.
        cells = [(lib, cad, vname) for lib, cad, vname in manifest
                 if is_stale(lib, cad, vname, cds_dir, out_dir)
                 and not _has_ref(vname)]

    if not cells:
        print("s2v: nothing to regenerate")
        return

    os.makedirs(out_dir, exist_ok=True)

    virtuoso = find_virtuoso()
    if not virtuoso:
        sys.exit("error: cannot find 'virtuoso' -- add it to PATH")

    # Skip list: cadence cells whose Verilog already exists as a hand-written
    # ref. SKILL won't recurse into these; we'll just `\include "ref/X.v"`.
    skip_cad = {cad for cad, vname in mdict.items()
                if os.path.isfile(os.path.join(ref_dir, vname + ".v"))}
    known_vnames = set(mdict.values())
    if os.path.isdir(ref_dir):
        for f in os.listdir(ref_dir):
            if f.endswith(".v"):
                v = f[:-2]
                if v not in known_vnames:
                    skip_cad.add(v)
    skip_skill = "'(" + " ".join(f'"{c}"' for c in sorted(skip_cad)) + ")"

    # Preserve the raw netlists alongside the generated .v files so we can
    # inspect exactly what SKILL emits when something looks wrong.
    debug_nl_dir = os.path.join(out_dir, ".netlists")
    shutil.rmtree(debug_nl_dir, ignore_errors=True)
    os.makedirs(debug_nl_dir, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        calls = ["s2v_done = nil"]
        for lib, cad, _ in cells:
            calls.append(
                f's2v_done = s2v_walk( "{lib}" "{cad}" "{tmp}" {skip_skill} s2v_done )'
            )
        skill_input = SKILL_EXTRACT + "\n" + "\n".join(calls) + "\nexit()\n"

        print(f"s2v: running virtuoso (cds: {cds_dir})")
        result = subprocess.run(
            [virtuoso, "-nograph"], input=skill_input, text=True, cwd=cds_dir,
        )
        if result.returncode != 0:
            sys.exit(f"virtuoso exited with code {result.returncode}")

        netlists = sorted(f for f in os.listdir(tmp) if f.endswith(".netlist"))
        if not netlists:
            sys.exit("s2v: virtuoso produced no netlists")
        for nl_name in netlists:
            shutil.copy(os.path.join(tmp, nl_name), os.path.join(debug_nl_dir, nl_name))
            cell_name, ports, nets, insts, noconn_nets = parse_netlist(
                os.path.join(tmp, nl_name)
            )
            cell_name = mdict.get(cell_name, cell_name)
            generate_verilog(cell_name, ports, nets, insts, noconn_nets,
                             ref_dir, out_dir, mdict)

if __name__ == "__main__":
    main()
