#!/usr/bin/env python3
"""
gen-schem-tests -- mirror v/test/ to v/schematic-test/ and emit schematic.mk.

For each test (or shared helper) in v/test/ that includes a `ref/X.v` cell
listed in the manifest, write a copy to v/schematic-test/ with the include
rewritten to `schematic/X.v`. Helpers that themselves get copied are also
followed (a testbench's `include "test/Y.v"` becomes `include "schematic-test/Y.v"`
when Y was copied).

Then write v/schematic/schematic.mk listing every generated cell and its tests.

All path defaults resolve from the git root.
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

INCLUDE_RE = re.compile(r'`include\s+"(?P<dir>ref|test)/(?P<base>[^"]+\.v)"')


def find_git_root():
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def load_manifest(path):
    """Returns dict cadence_cell -> verilog_module. [library] section headers are
    skipped -- this script only cares about the cadence/verilog name pairing."""
    if not os.path.isfile(path):
        sys.exit(f"error: manifest not found: {path}")
    cells = {}
    for lineno, line in enumerate(Path(path).read_text().splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            continue
        parts = line.split()
        if len(parts) != 2:
            sys.exit(f"error: {path}:{lineno}: expected 2 tokens, got: {line}")
        cells[parts[0]] = parts[1]
    return cells


def find_files_to_copy(test_dir, vlog_names):
    """Names of files that include a manifest cell directly or via a copied helper."""
    files = {f.name: [(m["dir"], m["base"]) for m in INCLUDE_RE.finditer(f.read_text())]
             for f in Path(test_dir).glob("*.v")}

    needs = {n for n, incs in files.items()
             if any(d == "ref" and b[:-2] in vlog_names for d, b in incs)}

    changed = True
    while changed:
        changed = False
        for n, incs in files.items():
            if n in needs:
                continue
            if any(d == "test" and b in needs for d, b in incs):
                needs.add(n)
                changed = True
    return needs


def schem_basename(name):
    """Adder_8b-test.v -> Adder_8b-test-schem.v (so make targets don't collide with v/test/)."""
    assert name.endswith(".v")
    return name[:-2] + "-schem.v"


def rewrite(text, vlog_names, copied):
    def repl(m):
        d, b = m["dir"], m["base"]
        if d == "ref" and b[:-2] in vlog_names:
            return f'`include "schematic/{b}"'
        if d == "test" and b in copied:
            return f'`include "schematic-test/{schem_basename(b)}"'
        return m[0]
    return INCLUDE_RE.sub(repl, text)


def emit_mk(mk_path, schem_dir, schem_test_dir, manifest):
    vlog_names = sorted(set(manifest.values()))
    srcs = [f"{v}.v" for v in vlog_names if (Path(schem_dir) / f"{v}.v").is_file()]
    tests = sorted(
        f.name
        for v in vlog_names
        for f in Path(schem_test_dir).glob(f"{v}-*test-schem.v")
        if f.name.endswith("-test-schem.v")
    )

    def block(name, items):
        if not items:
            return [f"{name} ="]
        return [f"{name} = \\"] + [f"  {x} \\" for x in items[:-1]] + [f"  {items[-1]}"]

    lines = [
        "# Auto-generated by gen-schem-tests. Do not edit by hand.",
        "",
        *block("schem_srcs", srcs),
        "",
        *block("schem_tests", tests),
        "",
        "$(eval $(call check_part,schem))",
        "",
    ]
    Path(mk_path).write_text("\n".join(lines))


def main():
    root = find_git_root()
    p = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    p.add_argument("-manifest",   default=root and f"{root}/cadence/cells.txt", metavar="FILE")
    p.add_argument("-test",       default=root and f"{root}/v/test",            metavar="DIR")
    p.add_argument("-schem",      default=root and f"{root}/v/schematic",       metavar="DIR")
    p.add_argument("-schem-test", dest="schem_test",
                   default=root and f"{root}/v/schematic-test", metavar="DIR")
    args = p.parse_args()

    for k in ("manifest", "test", "schem", "schem_test"):
        if getattr(args, k) is None:
            sys.exit(f"error: not in a git checkout -- pass -{k.replace('_','-')} explicitly")

    manifest   = load_manifest(args.manifest)
    vlog_names = set(manifest.values())

    Path(args.schem_test).mkdir(parents=True, exist_ok=True)
    for f in Path(args.schem_test).glob("*.v"):
        f.unlink()  # wipe stale entries (manifest may have shrunk)

    # Schematic-derived modules often have width quirks (extra fanout pins,
    # 7-clock H-trees, structural concats) -- wrap each schem-test file with
    # lint-off pragmas so the testbench's narrower signals can pad/expand.
    LINT = ("UNUSED", "UNUSEDSIGNAL", "UNDRIVEN",
            "WIDTH", "WIDTHCONCAT", "WIDTHEXPAND", "WIDTHTRUNC")
    prefix = "".join(f"/* verilator lint_off {w} */\n" for w in LINT)
    suffix = "".join(f"/* verilator lint_on {w} */\n" for w in reversed(LINT))

    to_copy = find_files_to_copy(args.test, vlog_names)
    for name in sorted(to_copy):
        text = Path(args.test, name).read_text()
        out  = Path(args.schem_test, schem_basename(name))
        out.write_text(prefix + rewrite(text, vlog_names, to_copy) + suffix)
        print(f"gen-schem-tests: wrote {out}")

    mk_path = Path(args.schem, "schematic.mk")
    emit_mk(mk_path, args.schem, args.schem_test, manifest)
    print(f"gen-schem-tests: wrote {mk_path}")


if __name__ == "__main__":
    main()
