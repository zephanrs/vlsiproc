build*/
build-simplify/

# Cadence user preferences, history, and session state
cadence/.cadence/
cadence/perf/
cadence/drc/
cadence/lvs/
cadence/.QRC.run
cadence/.preRcx.Last.State
cadence/.qrc.Last.state
cadence/edges.xml
cadence/mux4.png
cadence/xcelium.d
.cadence/perf/

# Cadence log files
cadence/libManager.log
cadence/*.log

# Cadence generated thumbnails (auto-regenerated on open)
**/thumbnail_*.png

# Cadence lock files (created during active sessions)
**/*.lck
**/*cdslck*
**/cdslck/

# Ignore all log, cache, and tmp files
*.tmp*
*.log
*.log.*
logs*/
*oacache*

# Cadence/Xcelium generated files
xcelium.d/
xrun.history
xmvlog.log
