//Verilog HDL for "processor", "ProcCtrl" "functional"

module ProcCtrl (
  clk,
  rst,

  idmem_val,
  idmem_type,

  pc_en,
  addr_sel,
  fetch_en,
  ab_en,
  pc_sel,
  op1_sel,
  op2_sel,
  addr_en,
  wd_en,
  rf_wen,
  imm_type,

  inst,
  eq 
);

  input        clk;
  input        rst;

  output       idmem_val;
  output       idmem_type;

  output       pc_en;
  output       addr_sel;
  output       fetch_en;
  output       ab_en;
  output       pc_sel;
  output       op1_sel;
  output [1:0] op2_sel;
  output       addr_en;
  output       wd_en;
  output       rf_wen;

  input  [15:0] inst;
  input         eq;

  reg [3:0] state;
  wire [3:0] next_state;

  always @( posedge clk ) begin
    if ( rst )
      state <= 4'b0101;
    else
      state <= next_state;
  end

  wire [3:0] state_inc;

  Incrementer_4b state_incrementer
  (
    .in  (state),
    .out (state_inc)
  );

  wire [1:0] ns_sel;

  assign ns_sel[1] = ( ~state[3] &  state[2] &  state[0] )
                   | ( ~state[3] &  state[2] &  state[1] )
                   | (  state[3] &  state[2] & ~state[0] )
                   | (  state[3] & ~state[2] &  state[0] )
                   | ( ~state[3] & ~state[2] &  state[1] &  state[0] & ~eq );

  assign ns_sel[0] = ( ~state[2] & ~state[1] & ~state[0] )
                   | (  state[2] &  state[1] &  state[0] )
                   | (  state[2] &  state[3] &  state[0] );

  Mux4_4b ns_mux
  (
    .in0 ( 4'b0101 ),
    .in1 ( 4'b0001 ),
    .in2 ( state_inc ),
    .in3 ( inst[15:12] ),
    .sel ( ns_sel ),
    .out ( next_state )
  );

  assign op1_sel    =  state[2];
  assign pc_sel     =  state[1] & ~state[3];
  assign op2_sel[1] =  state[2] |  state[3];
  assign op2_sel[0] =  state[1] & ~state[0];

  assign addr_sel   = ~state[0];
  assign idmem_type = ~state[2];
  assign addr_en    =  state[0] &  state[3] & ~state[2];
  assign rf_wen     =  state[0] & ~state[1] & ~state[2] & ~state[3];
  assign fetch_en   =  state[1] &  state[2] & ~state[0] & ~state[3];
  assign ab_en      =  state[0] &  state[1] &  state[2] & ~state[3];

  assign pc_en      = (  state[0] &  state[1] &  state[2] &  state[3] )
                    | (  state[1] & ~state[0] & ~state[3] )
                    | (  state[2] & ~state[0] & ~state[3] );

  assign wd_en      = (  state[0] &  state[2] &  state[3] & ~state[1] )
                    | (  state[1] &  state[2] &  state[3] & ~state[0] )
                    | ( ~state[0] & ~state[1] & ~state[2] );

  assign idmem_val  = (  state[0] &  state[2] & ~state[1] & ~state[3] )
                    | (  state[1] &  state[3] & ~state[0] & ~state[2] )
                    | (  state[2] &  state[3] & ~state[0] & ~state[1] );


endmodule

